# React App (client-side: these end up in the browser bundle, so only put public values here)
REACT_APP_ENV=development
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key

# Serverless Functions (server-side only). All optional: Yahoo Finance needs no key.
FMP_KEY=
POLYGON_KEY=
ALPHA_VANTAGE_KEY=
FRED_API_KEY=
ANTHROPIC_API_KEY=
